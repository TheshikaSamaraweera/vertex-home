{
  "name": "mlmsittu-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "api:generate": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "api:sync": "npm run api:fetch && npm run api:generate",
    "api:check": "node scripts/check-api-drift.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "d3-hierarchy": "^3.1.2",
    "i18next": "^24.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.4.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
