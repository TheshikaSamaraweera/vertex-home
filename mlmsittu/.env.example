# ==============================================================================================
# MLM Sittu — deployment configuration
#
#   cp .env.example .env
#   chmod 600 .env
#
# Never commit the filled-in .env. Everything here is read by docker-compose.yml at start; none of
# it is baked into an image, so the same image runs in every environment.
# ==============================================================================================


# --- Database ---------------------------------------------------------------------------------
DB_NAME=mlmsitty

# The application's account. Weaker on purpose: no DDL rights, and no UPDATE or DELETE on
# audit_log. That is what makes the audit trail append-only in fact rather than by convention.
#
# 01-app-role.sh creates this role using the value below, when the database is first created.
# There is no second place to change it. Generate one:
#
#   openssl rand -base64 24
#
# The script refuses to start if this is still 'mlmsittu_app' — that is the example value, and it
# is published in this repository.
DB_USER=mlmsittu_app
DB_PASSWORD=CHANGE_ME_app_password

# The owner, used by Flyway to run migrations because they create tables and extensions. This is
# also the PostgreSQL superuser inside the container.
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=CHANGE_ME_postgres_password


# --- NIC protection ---------------------------------------------------------------------------
# Generate each of these separately:
#
#   openssl rand -base64 48
#
# The application REFUSES TO START under the prod profile while these are unset, which is
# deliberate — a container that came up with the development keys would encrypt real identity
# numbers with a key published in this repository.
#
# *** These can never be changed once real NIC data exists. ***
# The pepper is baked into every stored hash; rotating it orphans every row, and there is no way
# to recompute the old hashes because the plaintext is never stored. Back them up somewhere that
# is not this server.
SECURITY_NIC_PEPPER=CHANGE_ME_generate_with_openssl
SECURITY_NIC_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl


# --- Web ----------------------------------------------------------------------------------------
# The port nginx listens on. Leave at 80 behind a load balancer that terminates TLS.
HTTP_PORT=80


# --- Email (optional) ---------------------------------------------------------------------------
# Filling these in is only half of it: the matching lines in docker-compose.yml are COMMENTED OUT
# and must be uncommented too. See DEPLOYMENT.md section 5.
#
# That is deliberate. An empty value is not an absent one — passing SPRING_MAIL_HOST="" makes
# Spring autoconfigure a mailer aimed at localhost:587, which fails its health check and marks the
# container unhealthy while nothing is actually wrong.
#
# With mail off, purchase orders and reward notifications still work. The messages queue in
# outbox_message and go to the application log, and the backlog is delivered when you switch mail
# on later. Nothing is lost.
#
# Use an app-specific password, never the account's own. For Gmail that means a 16-character App
# Password, which requires 2-Step Verification on the account — and paste it WITHOUT the spaces
# Google shows it with. Gmail rejects the spaced form with a bare "535 Username and Password not
# accepted", which reads exactly like a wrong password.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
NOTIFICATIONS_MAIL_FROM=


# --- Public address ---------------------------------------------------------------------------
# REQUIRED, and not only when mail is on. The account-verification link is built from it, so an
# unset value sends every new customer a link to http://localhost:5173 — the developer's Vite
# server. The email sends successfully; only the recipient discovers it is dead.
#
# No trailing slash. Use https once TLS is in front of the web container.
#   APP_BASE_URL=https://your-domain.lk
APP_BASE_URL=


# --- Scale ------------------------------------------------------------------------------------
# Only relevant if you run more than one `app` container. Scheduled work — the outbox poller, the
# reorder scan, session cleanup — should run on exactly one of them, so set this to false on the
# others. With a single container, leave it alone.
# JOBS_SCHEDULER_ENABLED=true
