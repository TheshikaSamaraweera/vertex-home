{
  "info": {
    "name": "MLM Sittu — Phase 0 + 1",
    "description": "Manual verification for Gate 0 (foundation) and Gate 1 (identity, RBAC, audit).\n\nSetup:\n1. Start the app:  ./gradlew bootRun --args=\"--spring.profiles.active=seed\"\n2. Run the requests top to bottom. Postman keeps the session cookie for you.\n\nThe TOTP code is computed automatically by a pre-request script on the '2. Complete TOTP' request, using the collection variable totpSecret. You do not need a phone.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "password", "value": "Password123!", "type": "string" },
    {
      "key": "totpSecret",
      "value": "JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP",
      "type": "string",
      "description": "Shared dev secret for the six seeded roles. Overwritten automatically during the enrolment flow."
    },
    { "key": "challengeId", "value": "", "type": "string" },
    { "key": "targetUserId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Gate 0 — Foundation",
      "item": [
        {
          "name": "0.1 Health (expect 200 UP)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('status is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 Unknown endpoint (expect 404 + code, no stack trace)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/no-such-thing", "host": ["{{baseUrl}}"], "path": ["api", "v1", "no-such-thing"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('not 500', () => pm.expect(pm.response.code).to.not.eql(500));",
                  "const raw = pm.response.text();",
                  "pm.test('no Java class names leaked', () => {",
                  "  pm.expect(raw).to.not.include('java.');",
                  "  pm.expect(raw).to.not.include('org.springframework');",
                  "  pm.expect(raw).to.not.include('Exception');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "0.3 Unauthenticated call (expect 401 problem+json)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/probe/finance", "host": ["{{baseUrl}}"], "path": ["api", "v1", "probe", "finance"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('problem+json'));",
                  "pm.test('machine-readable code', () => pm.expect(pm.response.json().code).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Gate 1 — Login and RBAC",
      "item": [
        {
          "name": "1.1 Login step 1 — super admin (expect mfaRequired)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"super@mlmsittu.local\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('MFA demanded — a password alone is not enough for an admin', () => pm.expect(body.mfaRequired).to.be.true);",
                  "if (body.challengeId) pm.collectionVariables.set('challengeId', body.challengeId);",
                  "if (body.totpSecret) pm.collectionVariables.set('totpSecret', body.totpSecret);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Login step 2 — TOTP (code computed automatically)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"{{totpCode}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login/totp", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login", "totp"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// RFC 6238 TOTP, so you do not need an authenticator app to test.",
                  "function base32ToHex(base32) {",
                  "  const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "  let bits = '', hex = '';",
                  "  const cleaned = base32.replace(/=+$/, '').toUpperCase();",
                  "  for (let i = 0; i < cleaned.length; i++) {",
                  "    const val = alphabet.indexOf(cleaned.charAt(i));",
                  "    if (val < 0) throw new Error('totpSecret is not valid base32');",
                  "    bits += val.toString(2).padStart(5, '0');",
                  "  }",
                  "  for (let i = 0; i + 8 <= bits.length; i += 8) {",
                  "    hex += parseInt(bits.substr(i, 8), 2).toString(16).padStart(2, '0');",
                  "  }",
                  "  return hex;",
                  "}",
                  "",
                  "const secret = pm.collectionVariables.get('totpSecret');",
                  "const counter = Math.floor(Math.floor(Date.now() / 1000) / 30);",
                  "const counterHex = counter.toString(16).padStart(16, '0');",
                  "",
                  "const hmac = CryptoJS.HmacSHA1(",
                  "  CryptoJS.enc.Hex.parse(counterHex),",
                  "  CryptoJS.enc.Hex.parse(base32ToHex(secret))",
                  ").toString(CryptoJS.enc.Hex);",
                  "",
                  "const offset = parseInt(hmac.substr(hmac.length - 1), 16);",
                  "const binary = (parseInt(hmac.substr(offset * 2, 8), 16) & 0x7fffffff) % 1000000;",
                  "",
                  "pm.collectionVariables.set('totpCode', binary.toString().padStart(6, '0'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('session issued', () => pm.expect(body.mfaRequired).to.be.false);",
                  "pm.test('is super admin', () => pm.expect(body.user.roles).to.include('SUPER_ADMIN'));",
                  "pm.test('no secret material in response', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('passwordHash');",
                  "  pm.expect(pm.response.text()).to.not.include('totpSecret');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "1.4 Envelope shape (expect data + nextCursor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/probe/list", "host": ["{{baseUrl}}"], "path": ["api", "v1", "probe", "list"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('has data array', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('has nextCursor key', () => pm.expect(body).to.have.property('nextCursor'));",
                  "pm.test('nextCursor is null until Phase 7', () => pm.expect(body.nextCursor).to.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Probe SUPER_ADMIN (expect 200)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/probe/super-admin", "host": ["{{baseUrl}}"], "path": ["api", "v1", "probe", "super-admin"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "1.6 Probe FINANCE as super admin (expect 403)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/probe/finance", "host": ["{{baseUrl}}"], "path": ["api", "v1", "probe", "finance"] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 — super_admin is not a blanket bypass', () => pm.response.to.have.status(403));",
                  "pm.test('code is FORBIDDEN', () => pm.expect(pm.response.json().code).to.eql('FORBIDDEN'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Gate 1 — Audit and errors",
      "item": [
        {
          "name": "2.1 List users (captures a target id)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users"] } },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('envelope shape', () => pm.expect(body).to.have.property('nextCursor'));",
                  "const target = body.data.find(u => u.email === 'support@mlmsittu.local');",
                  "if (target) pm.collectionVariables.set('targetUserId', target.id);",
                  "pm.test('no password hash in list', () => pm.expect(pm.response.text()).to.not.include('argon2'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Change roles (writes an audit row with before/after)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"roleCodes\": [\"KYC_REVIEWER\", \"SUPPORT_AGENT\"]\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}/roles", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users", "{{targetUserId}}", "roles"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "2.3 Unknown role (expect 400 UNKNOWN_ROLE)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"roleCodes\": [\"WIZARD\"]\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}/roles", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users", "{{targetUserId}}", "roles"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('400', () => pm.response.to.have.status(400));", "pm.test('UNKNOWN_ROLE', () => pm.expect(pm.response.json().code).to.eql('UNKNOWN_ROLE'));"] }
            }
          ]
        },
        {
          "name": "2.4 Empty roles (expect 400 VALIDATION_FAILED)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"roleCodes\": []\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}/roles", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users", "{{targetUserId}}", "roles"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('400', () => pm.response.to.have.status(400));", "pm.test('VALIDATION_FAILED', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_FAILED'));"] }
            }
          ]
        },
        {
          "name": "2.5 Nonexistent user (expect 404 USER_NOT_FOUND)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/users/00000000-0000-0000-0000-000000000000", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users", "00000000-0000-0000-0000-000000000000"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('404', () => pm.response.to.have.status(404));", "pm.test('USER_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('USER_NOT_FOUND'));"] }
            }
          ]
        },
        {
          "name": "2.6 Logout (expect 204)",
          "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "2.7 Reuse cookie after logout (expect 401)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 — the old session is dead', () => pm.response.to.have.status(401));"] } }]
        }
      ]
    },
    {
      "name": "Gate 1 — Throttling",
      "item": [
        {
          "name": "3.1 Bad password — send 11 times, 11th must be 429",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"support@mlmsittu.local\",\n  \"password\": \"WrongPassword1!\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Click Send eleven times. The first ten are 401, the eleventh is 429.",
                  "pm.test('401 or 429 only', () => pm.expect([401, 429]).to.include(pm.response.code));",
                  "if (pm.response.code === 429) {",
                  "  pm.test('LOGIN_RATE_LIMITED', () => pm.expect(pm.response.json().code).to.eql('LOGIN_RATE_LIMITED'));",
                  "  console.log('Throttle tripped. Restart the app to clear it — the limiter is in memory until Phase 7.');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
